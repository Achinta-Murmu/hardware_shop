<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Android's own phone-to-phone transfer and backup carry the shop's data to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
